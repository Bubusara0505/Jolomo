# Только имена и безопасные значения по умолчанию. Реальные секреты в git не кладём.
DB_URL=jdbc:postgresql://localhost:5433/jolomo
DB_USER=jolomo
DB_PASSWORD=
SERVER_PORT=8080
OTP_PEPPER=
SMS_FAKE_LOG_BODY=false
SESSION_SECRET=
SMS_BODY_KEY=
COOKIE_SECURE=true
# Только для локальной отладки: SPRING_PROFILES_ACTIVE=dev вместе с SMS_FAKE_LOG_BODY=true
SPRING_PROFILES_ACTIVE=
IDENTITY_KEY=
# IDENTITY_DIR=  (необязательно; по умолчанию ~/.jolomo/identity, вне репозитория)
ADMIN_TOTP_KEY=
# ADMIN_BOOTSTRAP_LOGIN=owner  (только на время создания первого администратора)
DELIVERY_OTP_PEPPER=
# DELIVERY_LINK_BASE=https://example.kg/r  (база ссылки получателя в SMS)
# Ночная выгрузка (SP12-01). Выключена, пока EXPORT_ENABLED не true. Ключ псевдонимов хранить вместе с остальными ключами в копиях.
EXPORT_ENABLED=false
EXPORT_PSEUDONYM_KEY=
# EXPORT_DIR=/var/lib/jolomo/export  (по умолчанию ~/.jolomo/export)
# Ночное удаление просроченных синтетических данных (SP04-03). Включено по умолчанию, реальных людей не касается.
# PRIVACY_PURGE_ENABLED=false
# Web Push (SP11-02). Выключен, пока PUSH_ENABLED не true. Ключи: java tools/VapidKeygen.java (из папки backend).
PUSH_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:ops@example.kg  (контакт владельца сервиса для push-служб, обязателен при PUSH_ENABLED=true)
# PUSH_ALLOWED_HOSTS=  (необязательно; по умолчанию домены push-служб Chrome, Firefox, Safari и Edge)
